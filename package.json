{
  "name": "telegram-channel-menu-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.js\" \"public/**/*.{js,css,html}\" \"scripts/**/*.js\" \"test/**/*.js\" package.json README.md",
    "format:check": "prettier --check \"src/**/*.js\" \"public/**/*.{js,css,html}\" \"scripts/**/*.js\" \"test/**/*.js\" package.json README.md",
    "check": "npm test && node scripts/check-syntax.js && npm run format:check"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.14.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
